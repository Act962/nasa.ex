# Variáveis públicas do CI de PR. Placeholders: a imagem do PR nunca é publicada e PRs de fork
# não recebem secrets. Só precisam ser válidos para o `next build` (o Pusher exige cluster no import).
# O deploy da main usa e confere o secret real NEXT_PUBLIC_ENV (deploy-image.yml).
NEXT_PUBLIC_APP_URL=https://ci.invalid
NEXT_PUBLIC_BASE_URL=https://ci.invalid
NEXT_PUBLIC_PUSHER_APP_KEY=ci-placeholder
NEXT_PUBLIC_PUSHER_CLUSTER=us2
