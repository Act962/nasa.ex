{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Órbita produção local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "test:local:start"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "NERP teste Órbita :3001",
      "runtimeExecutable": "pnpm",
